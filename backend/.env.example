PORT=4000
FRONTEND_ORIGIN=http://localhost:5190

# Required for admin authentication
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Required by backend Supabase routes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key

# Optional: Firebase Admin. Set the database URL and either provide the
# service-account JSON or configure application-default credentials.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: AI endpoints
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: approval email
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
